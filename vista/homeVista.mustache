<main class="home">
    <section class="hero">
        <div class="terminal">
            <div class="terminal-header">
                <span class="dot red"></span>
                <span class="dot yellow"></span>
                <span class="dot green"></span>
            </div>
            <div class="terminal-body">
                <p><span class="prompt">$</span> whoami</p>
                <p class="response">tomas-diuorno</p>
                <p><span class="prompt">$</span> role</p>
                <p class="response">web developer</p>
                <p><span class="prompt">$</span> stack</p>
                <p class="response">php · java · javascript · mysql </p>
                <p><span class="prompt">$</span> status</p>
                <p class="response highlight">available_for_work = true</p>
            </div>
        </div>
    </section>

    <section class="about-section pad" id="about">
        <div class="container">

        <div class="section-header">
            <p class="section-command">$ ls about</p>
        </div>
        <div class="about-terminal">
            <div class="about-left">
                <h3 class="module-title">[ about_me ]</h3>
                <div class="about-content">
                    <p>
                        I am <span class="accent">Tomas Diuorno</span>, Web Developer.
                    </p>
                    <p>
                        I build scalable and maintainable web applications using
                        clean code principles and modern development practices.
                    </p>
                    <p>
                        I enjoy solving problems, collaborating in teams,
                        and continuously improving my technical stack.
                    </p>
                </div>
                <div class="terminal-buttons">
                    <a href="#contact" class="btn-hacker">contact.sh</a>
                    <a href="/public/cv/CV-Tomas-Diuorno.pdf"
                       download
                       class="btn-hacker-outline">
                        resume.pdf
                    </a>
                </div>
            </div>
            <div class="about-right">
                <div class="terminal-network">
                    <div class="terminal-header">
                        <span class="dot red"></span>
                        <span class="dot yellow"></span>
                        <span class="dot green"></span>
                    </div>

                <div class="network-panel">
                    <h3 class="module-title">[ network_node ]</h3>
                    <p class="status-line">
                        status: <span class="online">online</span>
                    </p>
                    <div class="connections">
                        <a href="https://github.com/TU_USUARIO"
                           target="_blank"
                           rel="noopener"
                           class="net-link">
                            > github
                        </a>
                        <a href="https://gitlab.com/TU_USUARIO"
                           target="_blank"
                           rel="noopener"
                           class="net-link">
                            > gitlab
                        </a>

                        <a href="https://linkedin.com/in/TU_USUARIO"
                           target="_blank"
                           rel="noopener"
                           class="net-link">
                            > linkedin
                        </a>
                    </div>
                </div>
                </div>
            </div>
        </div>
        </div>
    </section>

    <section class="skills-section pad" id="stack">
        <div class="container">

        <div class="section-header">
            <p class="section-command">$ ls stack</p>
        </div>
        <div class="skills-grid">
            {{#skills}}
                <div class="skill-module">
                    <div class="skill-icon">
                        <img src="/{{image}}" alt="{{title}}">
                    </div>
                    <p>{{title}}</p>
                </div>
            {{/skills}}
        </div>
        </div>
    </section>

    <section class="featured-section" id="projects">
        <div class="container">

            <div class="section-header">
                <p class="section-command">$ ls projects</p>
            </div>

            <div class="featured-grid">
                {{#projects}}

                <div class="featured-card">
                    <h3>{{title}}</h3>

                    <p class="featured-desc">
                        {{description}}
                    </p>

                    <div class="featured-stack">
                        {{#skills}}
                            <span class="tech">{{.}}</span>
                        {{/skills}}
                    </div>

                    <div class="featured-actions">
                        <a href="{{link}}"
                           target="_blank"
                           rel="noopener"
                           class="btn-project">
                            view_project.sh
                        </a>
                    </div>
                </div>

                {{/projects}}
            </div>
        </div>
    </section>
</main>